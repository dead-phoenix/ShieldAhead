      "groups": [
        {
          "id": "household-plan",
          "tasks": [
            {
              "description": "Store drinking water and non-perishable food for at least three days. Add a battery-powered radio if you have one, and replace expired items regularly.",
              "id": "household-plan.outage-plan",
              "title": "Set aside 72 hours of supplies",
            },
            {
              "description": "Place torches or battery lights in known spots, check they work, and keep spare batteries nearby.",
              "id": "household-plan.lighting-plan",
              "title": "Put backup lighting somewhere easy to find",
