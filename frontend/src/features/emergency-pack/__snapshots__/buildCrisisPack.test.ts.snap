        {
          "id": "children-pets",
          "tasks": [
            {
              "description": "Pack food, clothing, comfort items, medication and care instructions. Plan activities that don't need electricity.",
              "id": "children-pets.dependants-plan",
              "title": "Prepare supplies for children and dependants",
            },
            {
              "description": "Set aside enough food and water, check their medication, and keep a carrier or lead accessible in case you need to leave.",
              "id": "children-pets.pet-plan",
              "title": "Prepare supplies for pets",
            },
          ],
          "title": "Children and pets",
        },
        {
          "id": "health-access",
          "tasks": [
            {
              "description": "Write down each device and how long its battery lasts. Ask the equipment provider what to do in a long outage, and keep their number on paper.",
              "id": "health-access.powered-equipment",
              "title": "Make a backup plan for powered medical equipment",
            },
            {
              "description": "Ask a pharmacist or healthcare professional how long your medicine can stay unrefrigerated. Write down their instructions and any backup storage plan.",
              "id": "health-access.medicine-plan",
              "title": "Ask how to protect refrigerated medicine",
            },
          ],
          "title": "Health and accessibility",
        },
      ],
      "guidelines": {
        "donts": [
          "Do not use candles for lighting.",
          "Never run a generator indoors, in a garage, or in another enclosed space.",
          "Never connect a generator to household wiring yourself.",
