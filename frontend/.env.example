# Keep Mock data as the safe default until the backend contract is stable.
VITE_DATA_SOURCE=mock

# Used only when VITE_DATA_SOURCE=api.
# Local split: Vite on 5173, Flask on 5001.
# Single-link production: leave this empty so the browser calls /api on the same origin.
VITE_API_BASE_URL=http://127.0.0.1:5001
VITE_API_TIMEOUT_MS=20000
